    "scope": "Chương trình nhận hai số nguyên A, B trong [-99, 99] và in tổng; ngoài miền hoặc không phải số nguyên thì báo 'Invalid Input'.",
    "references": [
      "Slide S04 Domain Testing, ví dụ 'The program adds 2 numbers'"
    ],
    "assumptions": [
      "Thông báo lỗi đúng chữ 'Invalid Input'."
    ],
    "bva_model": "9 điểm theo slide; ví dụ dùng LB-1, LB, LB+1, UB-1, UB, UB+1"
  },
  "requirements": [
    {
      "id": "SUM-1",
      "text": "Với -99 ≤ A ≤ 99 và -99 ≤ B ≤ 99 (số nguyên), hệ thống hiển thị SUM = A + B."
    },
    {
      "id": "SUM-2",
      "text": "Nếu A hoặc B ngoài [-99, 99] hoặc không phải số nguyên, hệ thống hiển thị 'Invalid Input'."
    }
  ],
