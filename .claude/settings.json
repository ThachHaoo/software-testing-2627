{
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },
  "cleanupPeriodDays": 365,
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(python tools/*)",
      "Bash(python .claude/skills/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(npx playwright test*)"
    ],
    "deny": [
      "Edit(/HW02/appendix/ai-outputs/**)",
      "Write(/HW02/appendix/ai-outputs/**)",
      "Edit(/HW02/appendix/A_prompt_log.md)",
      "Write(/HW02/appendix/A_prompt_log.md)"
    ]
  }
}
